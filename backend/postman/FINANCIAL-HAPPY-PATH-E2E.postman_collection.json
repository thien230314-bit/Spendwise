            },
            "url": {
              "raw": "{{baseUrl}}/api/transfers/p2p",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers",
                "p2p"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('05.2: Replayed P2P transfer returns cached response with replayed: true and exact same ID', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.environment.get('replay_p2p_id'));",
                  "  pm.expect(json.replayed).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
