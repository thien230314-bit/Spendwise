{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedOrigins": [],
  "Jwt": {
    "Issuer": "SpendWise.API",
    "Audience": "SpendWise.Frontend",
    "AccessTokenMinutes": 15
  },
  "SePayBankHub": {
    "Enabled": false,
    "Environment": "Sandbox",
    "SandboxBaseUrl": "https://bankhub-api-sandbox.sepay.vn",
    "ProductionBaseUrl": "https://bankhub-api.sepay.vn",
    "CompletionRedirectUri": "http://localhost:5173/bank-connections/callback",
    "AllowedCompletionRedirectOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173"
    ],
    "AllowedIpRanges": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "EmailVerificationPermitLimit": 10,
    "FinancialPermitLimit": 30,
    "AiPermitLimit": 15,
    "UserDiscoveryPermitLimit": 30,
    "ApiReadPermitLimit": 60,
    "ApiReadConcurrentLimit": 10
  }
}