                "linked-accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('01.7: User A linked accounts returns 200 containing TPBank 0005 Active', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array').that.is.not.empty;",
                  "  var conn = json.find(function(c) { return c.maskedAccountNumber === '****0005'; });",
                  "  pm.expect(conn).to.not.be.undefined;",
                  "  pm.expect(conn.status).to.eql('Active');",
                  "  pm.environment.set('userA_bankConnId', conn.bankConnectionId);",
                  "});"
                ]
              }
