                "test-mode",
                "wallet-top-ups"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('04.1: Test mode top-up challenge verification (200 Pending or 409 Active Exists)', function () {",
                  "  if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
