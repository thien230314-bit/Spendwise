# SpendWise Frontend — Environment Configuration Example
#
# Copy this file to .env.local for local development.
# .env.local is git-ignored and must NEVER be committed.
#
# SECURITY NOTICE:
# Do NOT add any backend secrets, JWT signing keys, database credentials,
# API keys for AI providers (OpenAI, Gemini, Claude), SePay secrets,
# or SMTP credentials here. The frontend must NOT hold server-side secrets.
# All such secrets belong in the backend server configuration only.
#
# ============================================================
# REQUIRED
# ============================================================

# Base URL for the SpendWise backend REST API.
# Must NOT have a trailing slash.
# Example (local development):
VITE_API_BASE_URL=https://localhost:7256/api

# ============================================================
# OPTIONAL — override defaults if needed
# ============================================================

# Request timeout in milliseconds (default: 30000)
# VITE_API_TIMEOUT_MS=30000
