    {
      "name": "04 - SePay Test Mode Top-Up & Withdrawal Invariants",
      "item": [
        {
          "name": "04.1 - User A Create SePay Test Mode Top-Up Challenge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userA_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"bankConnectionId\":\"{{userA_bankConnId}}\",\"walletId\":\"{{userA_primaryWalletId}}\",\"amount\":50000,\"securityPin\":\"{{default_pin}}\",\"idempotencyKey\":\"topup-happy-1793279190423\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bank-connections/test-mode/wallet-top-ups",
